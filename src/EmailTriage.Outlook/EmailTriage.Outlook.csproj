<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Outlook is reached by late binding (IDispatch), so no PIA or type
         library is needed at build time. The solution therefore compiles on
         any OS; it only *runs* on Windows with classic Outlook installed. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- UI Automation (System.Windows.Automation), which presses the Teams
       button on a meeting window. Only the framework reference: nothing here
       draws any WPF, so UseWPF and its implicit usings stay off. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailTriage.Core\EmailTriage.Core.csproj" />
  </ItemGroup>

</Project>
