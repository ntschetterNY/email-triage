<Project Sdk="Microsoft.NET.Sdk">

  <!-- The phone companion: a small HTTPS API the iPhone app talks to over the
       local network. Kestrel opens its own socket, so unlike HttpListener it
       needs no URL reservation and no admin rights. No Windows dependencies,
       so it builds and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailTriage.Core\EmailTriage.Core.csproj" />
  </ItemGroup>

</Project>
