<Window x:Class="EmailTriage.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:EmailTriage.App.ViewModels"
        xmlns:views="clr-namespace:EmailTriage.App.Views"
        Title="Email Triage"
        Height="820" Width="1400"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- ===== triage list row ===== -->
        <DataTemplate x:Key="MailRowTemplate" DataType="{x:Type vm:MailRowViewModel}">
            <StackPanel>
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- unread marker -->
                <Border Grid.Column="0" Width="3" CornerRadius="2"
                        Background="{StaticResource Accent}"
                        Visibility="{Binding IsUnread, Converter={StaticResource BoolVis}}" />

                <!-- conversation arrow, as in Outlook: lists each message, filed ones too (Right / Left) -->
                <Button Grid.Column="1" Click="OnExpandClick" Focusable="False" Cursor="Hand"
                        VerticalAlignment="Top" Margin="2,7,0,0" Padding="2,0"
                        ToolTip="Show each message in this conversation"
                        Visibility="{Binding CanExpand, Converter={StaticResource BoolVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Hit" CornerRadius="3" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Hit" Property="Background" Value="#337AA2F7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="ExpandGlyph" Text="&#x25B8;" FontSize="12" Foreground="{StaticResource Muted}" />
                </Button>

                <StackPanel Grid.Column="2" Margin="2,6,8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SenderText" Text="{Binding Sender}" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" MaxWidth="240">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- messages in the conversation -->
                        <TextBlock x:Name="CountText" Text="{Binding Count}" FontSize="11" Margin="6,1,0,0"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasCount, Converter={StaticResource BoolVis}}" />

                        <!-- your follow-up is the newest message -->
                        <Border x:Name="SentTag" Background="#337AA2F7" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                Visibility="{Binding LatestIsMine, Converter={StaticResource BoolVis}}">
                            <TextBlock x:Name="SentText" Text="SENT" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource Accent}" />
                        </Border>

                        <!-- flagged for action -->
                        <Border Background="#33E0AF68" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                Visibility="{Binding IsActionRequired, Converter={StaticResource BoolVis}}">
                            <TextBlock x:Name="ActionText" Text="ACTION" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource Warn}" />
                        </Border>

                        <!-- meeting invitation, cancellation or response -->
                        <Border Background="#3398C379" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                Visibility="{Binding HasKindTag, Converter={StaticResource BoolVis}}">
                            <TextBlock x:Name="KindText" Text="{Binding KindTag}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource Ok}" />
                        </Border>

                        <TextBlock x:Name="ClipText" Text="📎" FontSize="10" Margin="6,0,0,0" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}" />
                    </StackPanel>

                    <TextBlock x:Name="SubjectText" Text="{Binding Subject}" FontSize="13" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Text}" />
                </StackPanel>

                <TextBlock x:Name="WhenText" Grid.Column="3" Text="{Binding When}" FontSize="11"
                           Foreground="{StaticResource Muted}"
                           VerticalAlignment="Top" Margin="0,8,10,0" />
            </Grid>

            <!-- the expanded conversation: click a message to read just it, with its attachments -->
            <StackPanel Margin="22,0,6,6" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Finding the rest of the conversation..." FontSize="11" Margin="8,0,0,4"
                           Foreground="{StaticResource SelectedMuted}"
                           Visibility="{Binding IsLoadingMessages, Converter={StaticResource BoolVis}}" />
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConversationMessageViewModel}">
                            <Border x:Name="MsgRow" Cursor="Hand" CornerRadius="4" Padding="8,4" Margin="0,1"
                                    Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"
                                    PreviewMouseLeftButtonDown="OnConversationMessageClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MsgSender" Text="{Binding Sender}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource SelectedText}" />
                                    <TextBlock Grid.Column="1" Text="&#x1F4CE;" FontSize="10" Margin="6,0,0,0"
                                               Foreground="{StaticResource SelectedMuted}"
                                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11" Margin="8,0,0,0"
                                               Foreground="{StaticResource SelectedMuted}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter TargetName="MsgSender" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <Trigger SourceName="MsgRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MsgRow" Property="Background" Value="#14000000" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                    <Setter TargetName="MsgRow" Property="Background" Value="#26000000" />
                                    <Setter TargetName="MsgRow" Property="BorderBrush" Value="{StaticResource SelectedText}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            </StackPanel>

            <!-- The selected row sits on light yellow, so its text turns dark to stay readable.
                 Template triggers outrank the sender's style triggers, so this wins for unread mail too. -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SenderText" Property="Foreground" Value="{StaticResource SelectedText}" />
                    <Setter TargetName="SubjectText" Property="Foreground" Value="{StaticResource SelectedText}" />
                    <Setter TargetName="WhenText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                    <Setter TargetName="ClipText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                    <Setter TargetName="ActionText" Property="Foreground" Value="#8A5A00" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                    <Setter TargetName="SentText" Property="Foreground" Value="#1F4FA8" />
                    <Setter TargetName="KindText" Property="Foreground" Value="#2E6B1F" />
                    <Setter TargetName="ExpandGlyph" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ExpandGlyph" Property="Text" Value="&#x25BE;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Light yellow selection that is easy to find at a glance: the triage list,
             the move/snooze palette and contact suggestions. Their templates darken
             the text of the selected row to match. -->
        <Style x:Key="MailRowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Margin="4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedRow}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#15FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The triage list adds the Shift+arrow multi-selection: marked rows get a
             faint wash of the selection yellow, and the caret row keeps the full one. -->
        <Style x:Key="TriageRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource MailRowContainer}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                    <Setter Property="Background" Value="#45FFF1A8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                CornerRadius="5" Margin="4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Raised}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#15FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="AppRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= top bar ================= -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Triage" FontSize="12" Padding="12,6" Tag="Triage"
                               MouseLeftButtonUp="OnSectionTabClick">
                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="Show this tab · or" />
                                <Run Text="{Binding SectionKey, Mode=OneWay}" />
                                <Run Text="to cycle" />
                            </TextBlock>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource SectionActive}, ConverterParameter=Triage}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ActionsTabTitle}" FontSize="12" Padding="12,6" Tag="Actions"
                               MouseLeftButtonUp="OnSectionTabClick">
                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="Show this tab · or" />
                                <Run Text="{Binding SectionKey, Mode=OneWay}" />
                                <Run Text="to cycle" />
                            </TextBlock>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource SectionActive}, ConverterParameter=Actions}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Calendar" FontSize="12" Padding="12,6" Tag="Calendar"
                               MouseLeftButtonUp="OnSectionTabClick">
                        <TextBlock.ToolTip>
                            <TextBlock>
                                <Run Text="Show this tab · or" />
                                <Run Text="{Binding SectionKey, Mode=OneWay}" />
                                <Run Text="to cycle" />
                            </TextBlock>
                        </TextBlock.ToolTip>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section, Converter={StaticResource SectionActive}, ConverterParameter=Calendar}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Style="{StaticResource KeyCap}" Margin="4,0,0,0">
                        <TextBlock Text="Tab" Style="{StaticResource KeyCapText}" />
                    </Border>

                    <Button Content="✎ New email" Margin="18,0,0,0" Click="OnComposeClick"
                            Style="{StaticResource ReportButton}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="Write a new message ·" />
                                <Run Text="{Binding ComposeKey, Mode=OneWay}" />
                            </TextBlock>
                        </Button.ToolTip>
                    </Button>

                    <Button Content="⚙ Settings" Margin="6,0,0,0" Click="OnSettingsClick"
                            Style="{StaticResource ReportButton}">
                        <Button.ToolTip>
                            <TextBlock>
                                <Run Text="How your folders are named and nested, and organizing them ·" />
                                <Run Text="{Binding SettingsKey, Mode=OneWay}" />
                            </TextBlock>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>

                <!-- today strip: one pill per meeting on now or coming up shortly; a click opens its card -->
                <ItemsControl Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"
                              ItemsSource="{Binding Calendar.Pills}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Pill" Margin="3,0" Padding="10,3" CornerRadius="11" BorderThickness="1"
                                    MouseLeftButtonUp="OnPillClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Raised}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="{Binding Hint}" />
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,1,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Accent}" />
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- the countdown ("in 5 min") larger and bold so it reads at a glance -->
                                    <TextBlock x:Name="Label" FontSize="11.5"
                                               MaxWidth="{Binding DataContext.Calendar.PillMaxWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run
                                            Text="{Binding Lead, Mode=OneWay}" /><Run
                                            Text="{Binding Countdown, Mode=OneWay}" FontSize="15" FontWeight="Bold" /><Run
                                            Text="{Binding Tail, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Clear">
                                    <Setter TargetName="Pill" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="Transparent" />
                                    <Setter TargetName="Pill" Property="Cursor" Value="Arrow" />
                                    <Setter TargetName="Pill" Property="ToolTip" Value="{x:Null}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Ok}" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Now">
                                    <Setter TargetName="Pill" Property="Background" Value="#1F7AA2F7" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="#667AA2F7" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Soon">
                                    <Setter TargetName="Pill" Property="Background" Value="#2EE0AF68" />
                                    <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Warn}" />
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Warn}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- AI usage: green dot on your Claude login, amber on an API key; hover for the breakdown -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Background="Transparent"
                                ToolTip="{Binding AiUsageDetail}" ToolTipService.ShowDuration="60000"
                                Visibility="{Binding AiUsageText, Converter={StaticResource NullVis}}">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AiAuthState}" Value="Login">
                                            <Setter Property="Fill" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AiAuthState}" Value="ApiKey">
                                            <Setter Property="Fill" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding AiUsageText}" FontSize="11" Foreground="{StaticResource Muted}" />
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="Sent while this app is running. Delete the draft in Outlook to cancel."
                               Visibility="{Binding PendingScheduledCount, Converter={StaticResource CountVis}}">
                        <Run Text="{Binding PendingScheduledCount, Mode=OneWay}" />
                        <Run Text="scheduled" />
                    </TextBlock>

                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,14,0"
                               Visibility="{Binding PendingSnoozeCount, Converter={StaticResource CountVis}}">
                        <Run Text="{Binding PendingSnoozeCount, Mode=OneWay}" />
                        <Run Text="snoozed" />
                    </TextBlock>

                    <Ellipse Width="7" Height="7" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                    <!-- Room for the Lavish button, which sits above this bar (see the end of the window) -->
                    <Border Width="{Binding ActualWidth, ElementName=LavishButton}" Margin="14,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= content ================= -->
        <Grid Grid.Row="1">

            <!-- ========== TRIAGE ========== -->
            <Grid Visibility="{Binding Section, Converter={StaticResource SectionVis}, ConverterParameter=Triage}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="280" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- list filter: every conversation, or only the unread ones -->
                        <Border Grid.Row="0" Padding="10,8,10,6"
                                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All" Click="OnShowAllMail" ToolTip="Show every conversation">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Triage.ShowUnreadOnly}" Value="False">
                                                    <Setter Property="Tag" Value="on" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Unread" Margin="4,0,0,0" Click="OnShowUnreadMail" ToolTip="Show only unread conversations">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Triage.ShowUnreadOnly}" Value="True">
                                                    <Setter Property="Tag" Value="on" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Padding="10,8"
                                Visibility="{Binding Triage.IsSearching, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <!-- ask mode: the box holds a question for Claude, not a filter -->
                                <TextBlock DockPanel.Dock="Left" Text="Ask" Margin="0,0,8,0"
                                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}"
                                           Visibility="{Binding Triage.IsAiSearch, Converter={StaticResource BoolVis}}" />
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource Muted}"
                                           Text="Enter asks Claude"
                                           Visibility="{Binding Triage.IsAiSearch, Converter={StaticResource BoolVis}}" />
                                <!-- filter mode: the field syntax InboxQuery understands -->
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource Muted}"
                                           Text="from:  2:  subject:  * = anything"
                                           ToolTip="from: sender or CC · 2: or to: the To line · subject: · * stands for anything, e.g. 2:*@acme"
                                           Visibility="{Binding Triage.IsAiSearch, Converter={StaticResource BoolVisInv}}" />
                                <TextBox x:Name="SearchBox" Style="{StaticResource FlatInput}"
                                         Text="{Binding Triage.SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </Border>

                        <ListBox Grid.Row="2"
                                 x:Name="MailList"
                                 PreviewMouseLeftButtonDown="OnMailListMouseDown"
                                 ItemsSource="{Binding Triage.Rows}"
                                 SelectedItem="{Binding Triage.Selected, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource MailRowTemplate}"
                                 ItemContainerStyle="{StaticResource TriageRowContainer}"
                                 Background="Transparent" BorderThickness="0"
                                 Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />

                        <!-- a load in progress: a stalled Outlook must not pass for an empty inbox -->
                        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource Accent}"
                                     Visibility="{Binding Triage.IsLoading, Converter={StaticResource BoolVis}}" />

                        <TextBlock Grid.Row="2" Text="{Binding Triage.EmptyListText}" FontSize="13"
                                   Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Triage.Rows.Count, Converter={StaticResource CountVisInv}}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Border}"
                              HorizontalAlignment="Stretch" />

                <!-- reading pane -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="18,14" Background="{StaticResource Bg}"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                            Visibility="{Binding Triage.OpenBody, Converter={StaticResource NullVis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Print" Click="OnPrint" Margin="12,0,0,0"
                                        VerticalAlignment="Top" Style="{StaticResource ReportButton}"
                                        ToolTip="Print this conversation (Ctrl+P)" />
                                <!-- how far the message is zoomed; see MainWindow.ZoomReadout -->
                                <Border DockPanel.Dock="Right" x:Name="ZoomBadge" Visibility="Collapsed"
                                        Margin="12,2,0,0" VerticalAlignment="Top" Padding="8,3" CornerRadius="4"
                                        Background="#337AA2F7" Cursor="Hand"
                                        ToolTip="Reading pane zoom · click to go back to 100% (Ctrl+0 also resets; Ctrl+scroll or Ctrl+Plus/Minus zooms)">
                                    <TextBlock x:Name="ZoomBadgeText" Text="100%" FontSize="11.5"
                                               Foreground="{StaticResource Text}" />
                                </Border>
                                <TextBox Text="{Binding Triage.OpenBody.Subject, Mode=OneWay}" FontSize="17"
                                         FontWeight="SemiBold" Style="{StaticResource SelectableText}" />
                            </DockPanel>
                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Triage.OpenBody.SenderName}" FontSize="12" />
                                    <TextBlock Text="{Binding Triage.OpenBody.SenderAddress, StringFormat=' &lt;{0}&gt;'}"
                                               FontSize="12" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Triage.OpenBody.ReceivedDisplay}" FontSize="11.5"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                            </Grid>

                            <!-- who it went to: names here, full addresses on hover -->
                            <DockPanel Margin="0,5,0,0" ToolTip="{Binding Triage.OpenBody.ToDetail}">
                                <TextBlock Text="To" Width="26" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Triage.OpenBody.ToSummary}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel Margin="0,3,0,0" ToolTip="{Binding Triage.OpenBody.CcDetail}"
                                       Visibility="{Binding Triage.OpenBody.HasCc, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Cc" Width="26" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Triage.OpenBody.CcSummary}" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <!-- a meeting message: when it is, whether you are free, and y to answer -->
                            <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="6" BorderThickness="1"
                                    Background="#147AA2F7" BorderBrush="#447AA2F7"
                                    Visibility="{Binding Triage.HasInvite, Converter={StaticResource BoolVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Visibility="{Binding Triage.HasInviteAction, Converter={StaticResource BoolVis}}">
                                        <Border Style="{StaticResource KeyCap}">
                                            <TextBlock Text="{Binding RsvpKey}" Style="{StaticResource KeyCapText}" />
                                        </Border>
                                        <TextBlock Text="{Binding Triage.InviteAction}" FontSize="11.5" Margin="6,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="📅" /><Run Text="  " /><Run Text="{Binding Triage.InviteWhen, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Triage.InviteMeta}" FontSize="12" Margin="0,3,0,0"
                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Triage.InviteClash}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Triage.InviteClash, Converter={StaticResource NullVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Triage.InviteHasClash}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- attachments: click to open, or press v -->
                            <DockPanel Margin="0,9,0,0"
                                       Visibility="{Binding Triage.ThreadAttachments.Count, Converter={StaticResource CountVis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,6">
                                <Button Content="Save all" Click="OnSaveAllAttachmentsClick" Style="{StaticResource ReportButton}"
                                        ToolTip="Save every attachment to a folder · PNG pictures go into one PDF, a page each" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Triage.ThreadAttachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- click: preview (PDF, image, text) or open · drag: copy to a folder · ↗: open in its program -->
                                        <Border x:Name="Chip" Tag="{Binding}" Cursor="Hand" Margin="0,0,6,6"
                                                Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" CornerRadius="5" Padding="9,4,4,4"
                                                ToolTip="Click to preview or open · drag to a folder to save a copy"
                                                PreviewMouseLeftButtonDown="OnAttachmentMouseDown"
                                                MouseMove="OnAttachmentMouseMove"
                                                MouseLeftButtonUp="OnAttachmentClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📎" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="260"
                                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Margin="6,0,0,0"
                                                           Foreground="{StaticResource Muted}" />
                                                <Button Content="↗" Click="OnAttachmentOpenClick" Tag="{Binding}" Focusable="False"
                                                        Margin="6,0,0,0" Padding="4,0" Cursor="Hand" FontSize="11"
                                                        ToolTip="Open in its usual program">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Open" CornerRadius="3" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Muted}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Open" Property="Background" Value="#337AA2F7" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </DockPanel>

                            <!-- previewing an attachment instead of the email -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding Triage.IsPreviewing, Converter={StaticResource BoolVis}}">
                                <Border Background="#337AA2F7" CornerRadius="4" Padding="10,5">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Text}">
                                        <Run Text="Previewing" />
                                        <Run Text="{Binding Triage.PreviewName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="· Esc back to the email" Foreground="{StaticResource Muted}" />
                                    </TextBlock>
                                </Border>
                                <Button Content="Open in System Viewer" Click="OnOpenPreviewExternally" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Style="{StaticResource ReportButton}"
                                        ToolTip="Open this attachment in its usual program" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Stands in for the WebView while an overlay is open; see MainWindow.UpdateAirspaceAsync. -->
                    <Image Grid.Row="1" x:Name="BodySnapshot" Stretch="Fill" />

                    <wv2:WebView2 Grid.Row="1" x:Name="BodyView" DefaultBackgroundColor="#16181D" />

                    <TextBlock Grid.Row="1" Text="Select a message"
                               Foreground="{StaticResource Muted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Triage.OpenBody, Converter={StaticResource NullVisInv}}" />
                </Grid>
            </Grid>

            <!-- ========== ACTION BOARD ========== -->
            <!-- A plain Grid rather than a templated ContentControl, so the code-behind
                 can reach the email view inside it. -->
            <Grid DataContext="{Binding Actions}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVis}, ConverterParameter=Actions}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" MinHeight="160" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="4*" MinHeight="140" />
                </Grid.RowDefinitions>

                <!-- summary strip: counts, and who everything is waiting on -->
                <Border Grid.Row="0" Background="{StaticResource Panel}" Padding="16,10"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold">
                                <Run Text="{Binding OpenCount, Mode=OneWay}" /><Run Text=" open" />
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="14,0,0,0" Foreground="{StaticResource Accent}">
                                <Run Text="{Binding WaitingCount, Mode=OneWay}" /><Run Text=" waiting" />
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="14,0,0,0" Foreground="{StaticResource Danger}"
                                       Visibility="{Binding OverdueCount, Converter={StaticResource CountVis}}">
                                <Run Text="{Binding OverdueCount, Mode=OneWay}" /><Run Text=" overdue" />
                            </TextBlock>
                            <TextBlock Text="WAITING ON" FontSize="10" FontWeight="Bold" Margin="24,0,8,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding WaitingOnPeople.Count, Converter={StaticResource CountVis}}" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Button Content="Board" Click="OnShowBoard" ToolTip="The board (g toggles)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsByPerson}" Value="False">
                                                <Setter Property="Tag" Value="on" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="By person" Margin="4,0,0,0" Click="OnShowByPerson" ToolTip="Who everything is waiting on (g toggles)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsByPerson}" Value="True">
                                                <Setter Property="Tag" Value="on" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Done" Margin="4,0,0,0" Click="OnShowDoneLog" ToolTip="Everything finished, newest first (Shift+D toggles)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ReportButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDoneLog}" Value="True">
                                                <Setter Property="Tag" Value="on" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Border DockPanel.Dock="Right" Background="#33E0AF68" CornerRadius="4" Padding="8,2"
                                VerticalAlignment="Center" Margin="10,0,0,0"
                                Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}">
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Warn}">
                                <Run Text="Showing only" />
                                <Run Text="{Binding PersonFilter, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="· Esc shows all" />
                            </TextBlock>
                        </Border>

                        <!-- click a person to see only what is waiting on them -->
                        <ItemsControl ItemsSource="{Binding WaitingOnPeople}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnWaitingChipClick" Tag="{Binding Person}" Cursor="Hand"
                                            Focusable="False" Margin="0,2,6,2"
                                            ToolTip="Show only what is waiting on this person">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Chip" CornerRadius="10" Padding="9,2" BorderThickness="1"
                                                        Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding AnyOverdue}" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource Text}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- By person report (g): every open wait, grouped under who it is on -->
                <DockPanel Grid.Row="1" Margin="12,8,12,4"
                           Visibility="{Binding IsByPerson, Converter={StaticResource BoolVis}}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Sort by" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                        <ComboBox Width="160" Margin="8,0,0,0" FontSize="12"
                                  ItemsSource="{Binding SortChoices}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding ReportSort}" />
                        <Button Content="Export to Excel" Margin="16,0,0,0" Click="OnReportExport"
                                Style="{StaticResource ReportButton}" />
                        <Button Content="Email this report" Margin="8,0,0,0" Click="OnReportEmail"
                                Style="{StaticResource ReportButton}" />
                        <TextBlock Text="Click a row to open its card" FontSize="11.5" Margin="16,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Nothing is waiting on anyone" FontSize="13" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Report.Count, Converter={StaticResource CountVisInv}}" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Report}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel}" CornerRadius="7" Margin="0,0,0,10"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="14,9,14,6">
                                                    <TextBlock Text="{Binding Person}" FontSize="14" FontWeight="SemiBold" />
                                                    <TextBlock FontSize="12" Margin="10,2,0,0" Foreground="{StaticResource Muted}">
                                                        <Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" waiting" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Margin="10,2,0,0" Foreground="{StaticResource Danger}"
                                                               Visibility="{Binding OverdueCount, Converter={StaticResource CountVis}}">
                                                        <Run Text="{Binding OverdueCount, Mode=OneWay}" /><Run Text=" overdue" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Line" Padding="14,6" Cursor="Hand" Background="Transparent"
                                                                    Tag="{Binding Item}" MouseLeftButtonUp="OnReportRowClick"
                                                                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="3*" />
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="90" />
                                                                        <ColumnDefinition Width="90" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="Kind" Grid.Column="0" Text="{Binding Kind}" FontSize="11.5"
                                                                               Foreground="{StaticResource Warn}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Item.Subject}" FontSize="12.5"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding What}" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                                                                               Foreground="{StaticResource Muted}" />
                                                                    <TextBlock Grid.Column="3" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                               Text="{Binding SinceUtc, StringFormat='since {0:d MMM}'}" />
                                                                    <TextBlock x:Name="Due" Grid.Column="4" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                               Text="{Binding DueDisplay, StringFormat='due {0}'}"
                                                                               Visibility="{Binding DueDisplay, Converter={StaticResource NullVis}}" />
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <Trigger SourceName="Line" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Line" Property="Background" Value="#15FFFFFF" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Assigned">
                                                                    <Setter TargetName="Kind" Property="Foreground" Value="{StaticResource Accent}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter TargetName="Due" Property="Foreground" Value="{StaticResource Danger}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- the board, with today's finished cards in a strip beneath -->
                <DockPanel Grid.Row="1" Visibility="{Binding IsBoardShown, Converter={StaticResource BoolVis}}">
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,6" Padding="12,7" CornerRadius="7"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Text="Shift+D  the log" />
                        <TextBlock DockPanel.Dock="Left" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource Ok}" Margin="0,0,12,0">
                            <Run Text="✓ Done today · " /><Run Text="{Binding DoneTodayCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding DoneTodayLine}" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Columns}" Margin="8,8,8,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ColumnFrame" Margin="4,0" CornerRadius="7" BorderThickness="1"
                                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,9,12,6">
                                        <TextBlock x:Name="ColumnTitle" Text="{Binding Title}" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Count}" FontSize="10.5" Margin="8,0,0,0"
                                                   Foreground="{StaticResource Muted}" />
                                    </StackPanel>

                                    <ListBox ItemsSource="{Binding Items}"
                                             SelectedItem="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}"
                                             Background="Transparent" BorderThickness="0" Focusable="False"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AllowDrop="True" Tag="{Binding}"
                                             DragEnter="OnColumnDragOver" DragOver="OnColumnDragOver"
                                             DragLeave="OnColumnDragLeave" Drop="OnColumnDrop">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MailRowContainer}">
                                                <Setter Property="Margin" Value="0,0,0,5" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnBoardCardMouseDown" />
                                                <EventSetter Event="PreviewMouseMove" Handler="OnBoardCardMouseMove" />
                                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBoardCardClick" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Card" BorderThickness="1" CornerRadius="5" Padding="10,8"
                                                        Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" CornerRadius="2"
                                                                Background="{Binding Priority, Converter={StaticResource PriorityBrush}}" />
                                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                            <TextBlock x:Name="CardSubject" Text="{Binding DisplayTitle}" FontSize="12.5"
                                                                       TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource Text}" />
                                                            <TextBlock x:Name="CardSender" Text="{Binding SenderName}" FontSize="11" Margin="0,3,0,0"
                                                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />

                                                            <!-- what it is waiting on -->
                                                            <TextBlock x:Name="CardWaiting" Text="{Binding WaitingLine}" FontSize="11" Margin="0,4,0,0"
                                                                       TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                                                                       Visibility="{Binding IsWaiting, Converter={StaticResource BoolVis}}" />

                                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                <Border x:Name="DueChip" CornerRadius="3" Padding="5,0" Background="#22858C9A"
                                                                        Visibility="{Binding DueDisplay, Converter={StaticResource NullVis}}">
                                                                    <TextBlock x:Name="DueText" FontSize="10" Foreground="{StaticResource Muted}">
                                                                        <Run Text="due" /><Run Text=" " /><Run Text="{Binding DueDisplay, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Border>
                                                                <!-- its follow-up day has come: Shift+C drafts the follow-up -->
                                                                <Border x:Name="FollowUpChip" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" Background="#337AA2F7"
                                                                        Visibility="{Binding IsInFollowUp, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock x:Name="FollowUpText" FontSize="10" Foreground="{StaticResource Accent}"
                                                                               Text="{Binding ScheduledFollowUp}" />
                                                                </Border>
                                                                <!-- the wait has gone stale: c drafts the chase -->
                                                                <Border CornerRadius="3" Padding="5,0" Margin="6,0,0,0" Background="#33E5C07B"
                                                                        Visibility="{Binding IsFollowUpDue, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource Warn}"
                                                                               Text="{Binding FollowUpLabel}" />
                                                                </Border>
                                                                <!-- nobody has touched it for weeks: Shift+R walks these -->
                                                                <Border CornerRadius="3" Padding="5,0" Margin="6,0,0,0" Background="#22858C9A"
                                                                        Visibility="{Binding IsStale, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource Muted}"
                                                                               Text="{Binding StaleLabel}" />
                                                                </Border>
                                                                <TextBlock x:Name="NotesMark" Text="✎ notes" FontSize="10" Margin="8,0,0,0"
                                                                           Foreground="{StaticResource Muted}"
                                                                           Visibility="{Binding Notes, Converter={StaticResource NullVis}}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Danger}" />
                                                        <Setter TargetName="DueChip" Property="Background" Value="#33E06C75" />
                                                        <Setter TargetName="DueText" Property="Foreground" Value="{StaticResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedRow}" />
                                                        <Setter TargetName="CardSubject" Property="Foreground" Value="{StaticResource SelectedText}" />
                                                        <Setter TargetName="CardSender" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                                        <Setter TargetName="CardWaiting" Property="Foreground" Value="#8A5A00" />
                                                        <Setter TargetName="DueText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                                        <Setter TargetName="NotesMark" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                                        <Setter TargetName="FollowUpText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="ColumnFrame" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="ColumnTitle" Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <!-- Follow up takes no drops: it fills itself on each follow-up day -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFollowUps}" Value="True" />
                                        <Condition Binding="{Binding IsActive}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ColumnTitle" Property="Foreground" Value="{StaticResource Accent}" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                    <Setter TargetName="ColumnFrame" Property="BorderBrush" Value="{StaticResource Warn}" />
                                    <Setter TargetName="ColumnFrame" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="ColumnFrame" Property="Background" Value="#1AE0AF68" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </DockPanel>

                <!-- the done log (Shift+D): everything finished, newest first; x reopens -->
                <DockPanel Grid.Row="1" Margin="12,8,12,4"
                           Visibility="{Binding IsDoneLog, Converter={StaticResource BoolVis}}">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource Muted}"
                               Text="Everything you have marked done, newest first · x reopens one · o opens the mail · Shift+D back to the board" />
                    <Grid>
                        <TextBlock Text="Nothing finished yet" FontSize="13" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding DoneLog.Count, Converter={StaticResource CountVisInv}}" />
                        <ListBox ItemsSource="{Binding DoneLog}"
                                 SelectedItem="{Binding Selected, Mode=OneWay}"
                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MailRowContainer}">
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBoardCardClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" BorderThickness="1" CornerRadius="5" Padding="12,7"
                                            Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="When" Grid.Column="0" FontSize="11.5" Foreground="{StaticResource Ok}"
                                                       Text="{Binding CompletedDisplay}" />
                                            <TextBlock x:Name="What" Grid.Column="1" Text="{Binding DisplayTitle}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,10,0" Foreground="{StaticResource Text}" />
                                            <TextBlock x:Name="From" Grid.Column="2" Text="{Binding SenderName}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRow}" />
                                            <Setter TargetName="What" Property="Foreground" Value="{StaticResource SelectedText}" />
                                            <Setter TargetName="From" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                            <Setter TargetName="When" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

                <!-- selected card: the working details on the left, the email itself on the right -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" MinWidth="280" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- the selected card as a form: click and type, Enter saves.
                         The shortcut keys (b, Shift+A, t, d) put the cursor in these same fields. -->
                    <ScrollViewer Grid.Column="0" Padding="16,12" VerticalScrollBarVisibility="Auto"
                                  Background="{StaticResource Panel}" x:Name="ActionForm"
                                  Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
                        <ScrollViewer.Resources>
                            <Style x:Key="FormLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Margin" Value="0,16,0,6" />
                            </Style>
                            <Style x:Key="FormHint" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.5" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                <Setter Property="Margin" Value="0,3,0,0" />
                            </Style>
                            <Style x:Key="FormButton" TargetType="Button">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" Background="#337AA2F7" CornerRadius="4" Padding="10,4">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="11.5"
                                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="Background" Value="#557AA2F7" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <!-- "who" boxes remember everyone tagged before -->
                            <Style x:Key="PersonBox" TargetType="ComboBox">
                                <Setter Property="IsEditable" Value="True" />
                                <Setter Property="IsTextSearchEnabled" Value="True" />
                                <Setter Property="StaysOpenOnEdit" Value="True" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </ScrollViewer.Resources>

                        <StackPanel>
                            <TextBlock Text="{Binding Selected.DisplayTitle}" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                                <Run Text="{Binding Selected.SenderName, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Selected.Stage, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Selected.Priority, Mode=OneWay}" />
                                <Run Text="priority" />
                            </TextBlock>

                            <!-- due date -->
                            <TextBlock Text="DUE  (d)" Style="{StaticResource FormLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Set" Margin="6,0,0,0"
                                        Style="{StaticResource FormButton}" Click="OnFormDueSave" />
                                <TextBox x:Name="FormDue" Tag="form:due" Style="{StaticResource FlatInput}" FontSize="12.5"
                                         Text="{Binding DueDraft, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="e.g. fri, 14 oct, 3d, tomorrow 5pm · empty clears · Enter saves" Style="{StaticResource FormHint}" />

                            <!-- blocked by -->
                            <TextBlock Text="BLOCKED BY  (b)" Style="{StaticResource FormLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Blockers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="{StaticResource Raised}" CornerRadius="5"
                                                Padding="10,7" Margin="0,0,0,5">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,8,0"
                                                          IsChecked="{Binding IsResolved, Mode=OneWay}" Focusable="False"
                                                          Click="OnBlockerCheck" Tag="{Binding}"
                                                          ToolTip="Tick when it is no longer blocking (w clears the next one)" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource Muted}">
                                                        <Run Text="waiting on" />
                                                        <Run Text="{Binding WaitingOn, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding DueUtc, Mode=OneWay, StringFormat='· due {0:ddd d MMM}'}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Danger}" />
                                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{StaticResource Bg}" CornerRadius="5" Padding="10,8">
                                <StackPanel>
                                    <TextBox x:Name="FormBlockerWhat" Tag="form:blocker" Style="{StaticResource FlatInput}" FontSize="12.5"
                                             Text="{Binding NewBlockerWhat, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="What is it waiting for?" />
                                    <TextBlock Text="What is it waiting for?" Style="{StaticResource FormHint}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Tag="form:blocker" Style="{StaticResource PersonBox}"
                                                  ItemsSource="{Binding KnownPeople}"
                                                  Text="{Binding NewBlockerWho, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Tag="form:blocker" Margin="6,0,0,0" Style="{StaticResource FlatInput}" FontSize="12.5"
                                                 Text="{Binding NewBlockerDue, UpdateSourceTrigger=PropertyChanged}" ToolTip="Due (optional)" />
                                        <Button Grid.Column="2" Content="Add" Margin="6,0,0,0"
                                                Style="{StaticResource FormButton}" Click="OnFormBlockerAdd" />
                                    </Grid>
                                    <TextBlock Text="Who it is on · due (optional) · Enter adds and moves the card to Waiting" Style="{StaticResource FormHint}" />
                                </StackPanel>
                            </Border>

                            <!-- assigned to others -->
                            <TextBlock Text="ASSIGNED TO OTHERS  (Shift+A · c chases)" Style="{StaticResource FormLabel}" />
                            <ItemsControl ItemsSource="{Binding Selected.Assignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Background="{StaticResource Raised}" CornerRadius="5"
                                                Padding="10,7" Margin="0,0,0,5">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,8,0"
                                                          IsChecked="{Binding IsDone, Mode=OneWay}" Focusable="False"
                                                          Click="OnAssignmentCheck" Tag="{Binding}"
                                                          ToolTip="Tick when they have delivered" />
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PersonName}" FontSize="12.5" FontWeight="SemiBold" />
                                                        <Border Background="#3398C379" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                                                Visibility="{Binding HasBeenDrafted, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="CHASED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Ok}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Task}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Foreground="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding DueUtc, StringFormat='due {0:ddd d MMM}'}" FontSize="11"
                                                               Margin="0,2,0,0" Foreground="{StaticResource Muted}"
                                                               Visibility="{Binding DueUtc, Converter={StaticResource NullVis}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Danger}" />
                                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Background="{StaticResource Bg}" CornerRadius="5" Padding="10,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="FormAssignWho" Grid.Column="0" Tag="form:assign" Style="{StaticResource PersonBox}"
                                                  ItemsSource="{Binding KnownPeople}"
                                                  Text="{Binding NewAssignWho, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Tag="form:assign" Margin="6,0,0,0" Style="{StaticResource FlatInput}" FontSize="12.5"
                                                 Text="{Binding NewAssignDue, UpdateSourceTrigger=PropertyChanged}" ToolTip="Due (optional)" />
                                    </Grid>
                                    <TextBlock Text="Who · due (optional) - add an address as Name &lt;name@company.com&gt; to chase by email" Style="{StaticResource FormHint}" TextWrapping="Wrap" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="Assign" Margin="6,0,0,0"
                                                Style="{StaticResource FormButton}" Click="OnFormAssignAdd" />
                                        <TextBox Tag="form:assign" Style="{StaticResource FlatInput}" FontSize="12.5"
                                                 Text="{Binding NewAssignWhat, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="What they need to do" />
                                    </DockPanel>
                                    <TextBlock Text="What they need to do · Enter assigns and moves the card to Waiting" Style="{StaticResource FormHint}" />
                                </StackPanel>
                            </Border>

                            <!-- notes -->
                            <TextBlock Text="NOTES  (t)" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="FormNotes" Tag="form:notes" Style="{StaticResource FlatInput}" FontSize="12.5"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                                     Text="{Binding NotesDraft, UpdateSourceTrigger=PropertyChanged}" />
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Content="Save notes"
                                        Style="{StaticResource FormButton}" Click="OnFormNotesSave" />
                                <TextBlock Text="Ctrl+Enter saves" Style="{StaticResource FormHint}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Column="0" Text="Nothing selected" Foreground="{StaticResource Muted}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NullVisInv}}" />

                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Border}" HorizontalAlignment="Stretch" />

                    <!-- the email behind the card -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- how far the email is zoomed; only there while it matters. See MainWindow.ZoomReadout. -->
                        <Border Grid.Row="0" x:Name="ActionZoomStrip" Visibility="Collapsed" Padding="12,6"
                                Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                            <Border x:Name="ActionZoomBadge" HorizontalAlignment="Right" Padding="8,3" CornerRadius="4"
                                    Background="#337AA2F7" Cursor="Hand"
                                    ToolTip="Email zoom · click to go back to 100% (Ctrl+0 also resets; Ctrl+scroll or Ctrl+Plus/Minus zooms)">
                                <TextBlock x:Name="ActionZoomBadgeText" Text="100%" FontSize="11.5"
                                           Foreground="{StaticResource Text}" />
                            </Border>
                        </Border>

                        <Image Grid.Row="1" x:Name="ActionBodySnapshot" Stretch="Fill" />
                        <wv2:WebView2 Grid.Row="1" x:Name="ActionBodyView" DefaultBackgroundColor="#16181D" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========== CALENDAR ========== -->
            <Grid DataContext="{Binding Calendar}"
                  Visibility="{Binding DataContext.Section, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SectionVis}, ConverterParameter=Calendar}">
                <Grid.Resources>
                    <!-- one heading per day: Today, Tomorrow, Thu 25 Sep -->
                    <CollectionViewSource x:Key="AgendaDays" Source="{Binding Rows}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="Day" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>

                    <!-- tentative meetings are striped, as in Outlook -->
                    <LinearGradientBrush x:Key="TentativeStripes" StartPoint="0,0" EndPoint="7,7"
                                         MappingMode="Absolute" SpreadMethod="Repeat">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.5" />
                        <GradientStop Color="#387AA2F7" Offset="0.5" />
                        <GradientStop Color="#387AA2F7" Offset="1" />
                    </LinearGradientBrush>

                    <!-- a meeting in a month cell or the all-day row -->
                    <DataTemplate x:Key="CalendarChip">
                        <Border x:Name="Chip" Background="#1F7AA2F7" CornerRadius="3" Padding="5,1" Margin="0,0,0,2"
                                Cursor="Hand" MouseLeftButtonUp="OnCalendarItemClick" ToolTip="{Binding Row.Subject}">
                            <TextBlock x:Name="ChipText" Text="{Binding Text}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Event.IsAllDay}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#33E0AF68" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Event.NeedsResponse}" Value="True">
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Event.IsDeclined}" Value="True">
                                <Setter TargetName="ChipText" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Chip" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource SelectedRow}" />
                                <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                <Setter TargetName="Chip" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="380" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!-- views (1-5), back / today / forward, and the span shown -->
                <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{StaticResource Panel}"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Day" CommandParameter="Day" Click="OnCalendarViewClick" ToolTip="1" Margin="0,0,4,0"
                                Style="{StaticResource ReportButton}"
                                Tag="{Binding View, Converter={StaticResource MatchTag}, ConverterParameter=Day}" />
                        <Button Content="Work week" CommandParameter="WorkWeek" Click="OnCalendarViewClick" ToolTip="2" Margin="0,0,4,0"
                                Style="{StaticResource ReportButton}"
                                Tag="{Binding View, Converter={StaticResource MatchTag}, ConverterParameter=WorkWeek}" />
                        <Button Content="Week" CommandParameter="Week" Click="OnCalendarViewClick" ToolTip="3" Margin="0,0,4,0"
                                Style="{StaticResource ReportButton}"
                                Tag="{Binding View, Converter={StaticResource MatchTag}, ConverterParameter=Week}" />
                        <Button Content="Month" CommandParameter="Month" Click="OnCalendarViewClick" ToolTip="4" Margin="0,0,4,0"
                                Style="{StaticResource ReportButton}"
                                Tag="{Binding View, Converter={StaticResource MatchTag}, ConverterParameter=Month}" />
                        <Button Content="Agenda" CommandParameter="Agenda" Click="OnCalendarViewClick" ToolTip="5"
                                Style="{StaticResource ReportButton}"
                                Tag="{Binding View, Converter={StaticResource MatchTag}, ConverterParameter=Agenda}" />

                        <Button Content="+ New" Click="OnCalendarNew" ToolTip="New calendar entry (s or n)"
                                Margin="18,0,0,0" Style="{StaticResource ReportButton}" />

                        <StackPanel Orientation="Horizontal" Margin="18,0,0,0"
                                    Visibility="{Binding IsAgenda, Converter={StaticResource BoolVisInv}}">
                            <Button Content="‹" Click="OnCalendarPrev" ToolTip="Back (Left)" Margin="0,0,4,0" Style="{StaticResource ReportButton}" />
                            <Button Content="Today" Click="OnCalendarToday" ToolTip="Home" Margin="0,0,4,0" Style="{StaticResource ReportButton}" />
                            <Button Content="›" Click="OnCalendarNext" ToolTip="Forward (Right)" Style="{StaticResource ReportButton}" />
                        </StackPanel>

                        <TextBlock Text="{Binding RangeTitle}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                        <TextBlock Text="reading your calendar..." FontSize="11.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
                    </StackPanel>
                </Border>

                <!-- 1-3 · day, work week, week: a time grid, overlapping meetings side by side -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Bg}"
                      Visibility="{Binding IsTimeGrid, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- the day headings and all-day row leave room for the grid's scroll bar, so the columns line up -->
                    <Grid Grid.Row="0" x:Name="CalendarHeader">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Heading" Text="{Binding Header}" FontSize="12" Padding="8,8,0,6"
                                               Foreground="{StaticResource Muted}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Heading" Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Heading" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <Grid Grid.Row="1" x:Name="CalendarAllDay">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="all day" FontSize="10" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,8,6" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,1" Padding="3,3,3,1" MinHeight="24">
                                        <ItemsControl ItemsSource="{Binding AllDay}" ItemTemplate="{StaticResource CalendarChip}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <ScrollViewer Grid.Row="2" x:Name="CalendarScroll" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid Height="{Binding GridHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- one label per hour, each exactly an hour tall: the gap under the line is padding,
                                 not a margin, so the labels keep step with the hour lines and blocks all day -->
                            <ItemsControl Grid.Column="0" ItemsSource="{x:Static vm:CalendarViewModel.HourLabels}" IsHitTestVisible="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Height="{x:Static vm:CalendarViewModel.HourHeight}" FontSize="10"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Padding="0,2,8,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Column" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0" Background="Transparent"
                                                MouseLeftButtonDown="OnCalendarColumnMouseDown">
                                            <Grid ClipToBounds="True">
                                                <!-- outside working hours -->
                                                <Border VerticalAlignment="Top" Height="{Binding OffBefore}" Background="#33000000" IsHitTestVisible="False" />
                                                <Border VerticalAlignment="Bottom" Height="{Binding OffAfter}" Background="#33000000" IsHitTestVisible="False" />

                                                <!-- hour lines -->
                                                <ItemsControl ItemsSource="{x:Static vm:CalendarViewModel.HourLabels}" IsHitTestVisible="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="{x:Static vm:CalendarViewModel.HourHeight}" BorderBrush="#222A3040" BorderThickness="0,1,0,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl ItemsSource="{Binding Blocks}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><views:TimeGridPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="views:TimeGridPanel.Top" Value="{Binding Top}" />
                                                            <Setter Property="views:TimeGridPanel.BlockHeight" Value="{Binding Height}" />
                                                            <Setter Property="views:TimeGridPanel.Lane" Value="{Binding Lane}" />
                                                            <Setter Property="views:TimeGridPanel.Lanes" Value="{Binding Lanes}" />
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="Block" Background="#2E7AA2F7" BorderBrush="{StaticResource Accent}"
                                                                    BorderThickness="3,0,0,0" CornerRadius="3" Margin="1,1,2,1"
                                                                    Cursor="Hand" MouseLeftButtonUp="OnCalendarItemClick" ToolTip="{Binding Row.Subject}">
                                                                <Grid>
                                                                    <Border x:Name="Stripes" Background="{StaticResource TentativeStripes}" Visibility="Collapsed" />
                                                                    <!-- not answered yet: a dashed amber outline -->
                                                                    <Rectangle x:Name="Dashed" Stroke="{StaticResource Warn}" StrokeThickness="1"
                                                                               StrokeDashArray="3 2" RadiusX="2" RadiusY="2" Visibility="Collapsed" />
                                                                    <StackPanel Margin="5,1,4,1">
                                                                        <TextBlock x:Name="Subject" Text="{Binding Row.Subject}" FontSize="11.5" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock x:Name="Caption" Text="{Binding Caption}" FontSize="10.5" Margin="0,1,0,0"
                                                                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                                                   Visibility="{Binding IsRoomy, Converter={StaticResource BoolVis}}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Row.IsPast}" Value="True">
                                                                    <Setter TargetName="Block" Property="Opacity" Value="0.6" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTentative}" Value="True">
                                                                    <Setter TargetName="Stripes" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Event.NeedsResponse}" Value="True">
                                                                    <Setter TargetName="Dashed" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Block" Property="BorderBrush" Value="{StaticResource Warn}" />
                                                                    <Setter TargetName="Block" Property="Background" Value="#1FE0AF68" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Event.IsDeclined}" Value="True">
                                                                    <Setter TargetName="Subject" Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter TargetName="Block" Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Block" Property="Background" Value="{StaticResource SelectedRow}" />
                                                                    <Setter TargetName="Block" Property="Opacity" Value="1" />
                                                                    <Setter TargetName="Subject" Property="Foreground" Value="{StaticResource SelectedText}" />
                                                                    <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- now -->
                                                <Canvas IsHitTestVisible="False" Visibility="{Binding IsToday, Converter={StaticResource BoolVis}}">
                                                    <Border Canvas.Top="{Binding NowTop}" Height="2" Background="{StaticResource Danger}"
                                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter TargetName="Column" Property="Background" Value="#26000000" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 4 · month: six weeks; a click on a day opens it in the Day view -->
                <Grid Grid.Row="1" Grid.Column="0" Background="{StaticResource Bg}"
                      Visibility="{Binding IsMonth, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" ItemsSource="{x:Static vm:CalendarViewModel.WeekdayNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Padding="8,8,0,6" Foreground="{StaticResource Muted}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="6" Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Cell" BorderBrush="{StaticResource Border}" BorderThickness="1,1,0,0"
                                        Background="Transparent" ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonUp="OnMonthDayClick" ToolTip="Open this day">
                                    <StackPanel Margin="5,4,5,2">
                                        <TextBlock x:Name="DayNumber" Text="{Binding DayText}" FontSize="11.5" Margin="1,0,0,3" />
                                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource CalendarChip}" />
                                        <TextBlock Text="{Binding More}" FontSize="10.5" Margin="3,0,0,0" Foreground="{StaticResource Muted}"
                                                   Visibility="{Binding More, Converter={StaticResource NullVis}}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOtherMonth}" Value="True">
                                        <Setter TargetName="Cell" Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="DayNumber" Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter TargetName="DayNumber" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- 5 · agenda: the fortnight ahead as a list -->
                <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}"
                        Visibility="{Binding IsAgenda, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <ListBox x:Name="AgendaList"
                                 ItemsSource="{Binding Source={StaticResource AgendaDays}}"
                                 SelectedItem="{Binding AgendaSelected, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource MailRowContainer}"
                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 PreviewMouseLeftButtonUp="OnAgendaClick">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="Bold"
                                                       Margin="14,14,0,6" Foreground="{StaticResource Muted}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Row" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- on now -->
                                        <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource Accent}"
                                                Visibility="{Binding IsNow, Converter={StaticResource BoolVis}}" />

                                        <StackPanel Grid.Column="1" Margin="10,6,0,6">
                                            <TextBlock x:Name="TimeText" Text="{Binding Time}" FontSize="12.5" Foreground="{StaticResource Text}" />
                                            <TextBlock x:Name="LengthText" Text="{Binding Length}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Muted}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="6,6,8,6">
                                            <TextBlock x:Name="SubjectText" Text="{Binding Subject}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />
                                            <TextBlock x:Name="LocationText" Text="{Binding Location}" FontSize="11.5" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}"
                                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>

                                        <Border Grid.Column="3" x:Name="TagChip" Background="#33E0AF68" CornerRadius="3" Padding="5,0"
                                                Margin="0,8,10,0" VerticalAlignment="Top"
                                                Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}">
                                            <TextBlock x:Name="TagText" Text="{Binding Tag}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource Warn}" />
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                            <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Event.IsDeclined}" Value="True">
                                            <Setter TargetName="SubjectText" Property="TextDecorations" Value="Strikethrough" />
                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Row" Property="Opacity" Value="1" />
                                            <Setter TargetName="TimeText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                            <Setter TargetName="SubjectText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                            <Setter TargetName="LengthText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                            <Setter TargetName="LocationText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                            <Setter TargetName="TagText" Property="Foreground" Value="#8A5A00" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Nothing on your calendar" FontSize="13" Foreground="{StaticResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Rows.Count, Converter={StaticResource CountVisInv}}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Grid.Column="1" Width="4" Background="{StaticResource Border}" HorizontalAlignment="Stretch" />

                <!-- the selected meeting -->
                <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="22,18"
                              Visibility="{Binding Selected, Converter={StaticResource NullVis}}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Selected.Subject}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.When}" FontSize="13" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Selected.Location}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding Selected.HasLocation, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding Selected.About}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding Selected.About, Converter={StaticResource NullVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Join" Click="OnAgendaJoin" Margin="0,0,8,0" Style="{StaticResource ReportButton}" Tag="on"
                                    ToolTip="Open the meeting link (Enter)"
                                    Visibility="{Binding Detail.JoinUrl, Converter={StaticResource NullVis}}" />
                            <Button Content="Open in Outlook" Click="OnAgendaOpen" Margin="0,0,8,0" Style="{StaticResource ReportButton}"
                                    ToolTip="o" />
                            <Button Content="Answer…" Click="OnAgendaAnswer" Style="{StaticResource ReportButton}"
                                    ToolTip="Accept, maybe, follow or decline (y)"
                                    Visibility="{Binding Selected.CanRespond, Converter={StaticResource BoolVis}}" />
                        </StackPanel>

                        <!-- who is coming -->
                        <TextBlock Text="ATTENDEES" FontSize="10" FontWeight="Bold" Margin="0,22,0,8"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding Detail.Attendees.Count, Converter={StaticResource CountVis}, FallbackValue=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding Detail.Attendees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Raised}" CornerRadius="10" Padding="9,2" Margin="0,0,6,6"
                                            ToolTip="{Binding Address}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Mark" Text="·" FontSize="11.5" Margin="0,0,5,0" Foreground="{StaticResource Muted}" />
                                            <TextBlock Text="{Binding Display}" FontSize="11.5" />
                                            <TextBlock x:Name="Optional" Text=" (optional)" FontSize="11" Foreground="{StaticResource Muted}"
                                                       Visibility="{Binding IsOptional, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Response}" Value="Accepted">
                                            <Setter TargetName="Mark" Property="Text" Value="✓" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Response}" Value="Organized">
                                            <Setter TargetName="Mark" Property="Text" Value="★" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Response}" Value="Tentative">
                                            <Setter TargetName="Mark" Property="Text" Value="?" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Warn}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Response}" Value="Declined">
                                            <Setter TargetName="Mark" Property="Text" Value="✗" />
                                            <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- the invitation text -->
                        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="14,12" Margin="0,16,0,0"
                                Visibility="{Binding Detail.Body, Converter={StaticResource NullVis}}">
                            <TextBlock Text="{Binding Detail.Body}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Select a meeting" Foreground="{StaticResource Muted}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource NullVisInv}}" />
            </Grid>
        </Grid>

        <!-- ================= status bar ================= -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />

                <ItemsControl Grid.Column="1" HorizontalAlignment="Right" x:Name="HintStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,11,0">
                                <Border Style="{StaticResource KeyCap}">
                                    <TextBlock Text="{Binding Key}" Style="{StaticResource KeyCapText}" />
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ================= overlays ================= -->

        <!-- move (v) / snooze (h) palette -->
        <Grid Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding Triage.Palette.IsOpen, Converter={StaticResource BoolVis}}">
            <Border Width="620" MaxHeight="480" VerticalAlignment="Top" Margin="0,110,0,0"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,0">
                        <TextBlock Text="{Binding Triage.Palette.Title}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Triage.Palette.ContextLine}" FontSize="12.5"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Triage.Palette.OptionsLine}" FontSize="12"
                                   Margin="0,4,0,0" Foreground="{StaticResource Accent}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Triage.Palette.OptionsLine, Converter={StaticResource NullVis}}" />
                    </StackPanel>

                    <TextBox Grid.Row="1" x:Name="PaletteBox" Margin="16,12,16,10"
                             Style="{StaticResource FlatInput}" FontSize="15"
                             Text="{Binding Triage.Palette.Query, UpdateSourceTrigger=PropertyChanged}" />

                    <ListBox Grid.Row="2" Margin="8,0,8,0"
                             ItemsSource="{Binding Triage.Palette.Entries}"
                             SelectedIndex="{Binding Triage.Palette.SelectedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource MailRowContainer}"
                             Background="Transparent" BorderThickness="0" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding Padding}">
                                    <TextBlock x:Name="PrimaryText" Text="{Binding Primary}" FontSize="13.5"
                                               Foreground="{StaticResource Text}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="SecondaryText" Text="{Binding Secondary}" FontSize="11"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSecondary, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="PrimaryText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                        <Setter TargetName="SecondaryText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="#22E0AF68" CornerRadius="5" Margin="16,4"
                            VerticalAlignment="Top" Padding="12,10"
                            Visibility="{Binding Triage.Palette.CreatePrompt, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding Triage.Palette.CreatePrompt}" FontSize="12.5"
                                   Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource Raised}"
                            CornerRadius="0,0,9,9" Padding="16,9">
                        <TextBlock Text="{Binding Triage.Palette.Hint}" FontSize="11"
                                   Foreground="{StaticResource Muted}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- reply / forward composer (r / Shift+R / f) -->
        <Grid Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding Triage.Composer.IsOpen, Converter={StaticResource BoolVis}}">
            <!-- files dropped anywhere on it are attached; Preview events, because the
                 text boxes would otherwise take the drop as text -->
            <Border Width="820" MaxHeight="660" VerticalAlignment="Center"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    AllowDrop="True"
                    PreviewDragEnter="OnComposerDragOver" PreviewDragOver="OnComposerDragOver"
                    PreviewDragLeave="OnComposerDragLeave" PreviewDrop="OnComposerDrop">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.Resources>
                        <Style x:Key="RecipientLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="Width" Value="34" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,15,18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Triage.Composer.Header}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding Triage.Composer.Subject}" FontSize="12"
                                       Margin="12,0,0,0" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="560"
                                       Visibility="{Binding Triage.Composer.IsNew, Converter={StaticResource BoolVisInv}}" />
                        </StackPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="To" Style="{StaticResource RecipientLabel}" />
                            <TextBox x:Name="ToBox" Style="{StaticResource FlatInput}" FontSize="13"
                                     Text="{Binding Triage.Composer.ToLine, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="Cc" Style="{StaticResource RecipientLabel}" />
                            <TextBox x:Name="CcBox" Style="{StaticResource FlatInput}" FontSize="13"
                                     Text="{Binding Triage.Composer.CcLine, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="Bcc" Style="{StaticResource RecipientLabel}" />
                            <TextBox x:Name="BccBox" Style="{StaticResource FlatInput}" FontSize="13"
                                     Text="{Binding Triage.Composer.BccLine, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <!-- a new message types its own subject; replies keep Outlook's -->
                        <DockPanel Margin="0,5,0,0"
                                   Visibility="{Binding Triage.Composer.IsNew, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Subj." Style="{StaticResource RecipientLabel}" />
                            <TextBox x:Name="SubjectBox" Style="{StaticResource FlatInput}" FontSize="13"
                                     Text="{Binding Triage.Composer.SubjectLine, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- the message: rich text, driven by ComposerEditor in code-behind, which
                         keeps Triage.Composer.BodyText as its plain-text mirror -->
                    <RichTextBox Grid.Row="1" x:Name="ComposerBox" Margin="18,0,18,12"
                                 Style="{StaticResource FlatRichInput}" FontSize="13.5" MinHeight="180"
                                 VerticalScrollBarVisibility="Auto">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0" />
                            </Style>
                            <Style TargetType="Hyperlink">
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <!-- contact suggestions, dropped over the top of the message, or
                         beside the caret for an @mention (placed from code-behind) -->
                    <Border Grid.Row="1" x:Name="SuggestionPopup" Margin="52,0,18,0" VerticalAlignment="Top" Panel.ZIndex="1"
                            Background="{StaticResource Raised}" CornerRadius="0,0,6,6"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Visibility="{Binding Triage.Composer.HasSuggestions, Converter={StaticResource BoolVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <ListBox x:Name="SuggestionList"
                                 ItemsSource="{Binding Triage.Composer.Suggestions}"
                                 SelectedItem="{Binding Triage.Composer.SelectedSuggestion, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource MailRowContainer}"
                                 Background="Transparent" BorderThickness="0" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,6">
                                        <TextBlock x:Name="NameText" Text="{Binding Display}" FontSize="13"
                                                   Foreground="{StaticResource Text}" />
                                        <TextBlock x:Name="AddressText" Text="{Binding Address}" FontSize="11.5" Margin="10,1,0,0"
                                                   Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                            <Setter TargetName="AddressText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- files going out: a forward's originals and any dropped on the composer, ✕ to take one off -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Triage.Composer.Attachments}" Margin="18,0,18,8"
                                  Visibility="{Binding Triage.Composer.Attachments.Count, Converter={StaticResource CountVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="5" Padding="9,4,4,4" ToolTip="{Binding Where}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📎" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource Muted}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{StaticResource Muted}" />
                                        <Button Content="✕" Click="OnComposeAttachmentRemoveClick" Tag="{Binding}" Focusable="False"
                                                Margin="6,0,0,0" Padding="4,0" Cursor="Hand" FontSize="10"
                                                ToolTip="Don't attach this">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Remove" CornerRadius="3" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Muted}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Remove" Property="Background" Value="#337AA2F7" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- shown while files are dragged over the composer -->
                    <Border x:Name="ComposerDropHint" Grid.RowSpan="4" Panel.ZIndex="2" Visibility="Collapsed"
                            CornerRadius="9" Background="#E6181B22" BorderBrush="{StaticResource Accent}"
                            BorderThickness="2" IsHitTestVisible="False">
                        <TextBlock Text="Drop to attach" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}" />
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource Raised}"
                            CornerRadius="0,0,9,9" Padding="18,10">
                        <StackPanel>
                            <!-- formatting, as far as mail carries it the same way everywhere;
                                 Tag="on" marks what is in effect at the caret (set from code-behind) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <StackPanel.Resources>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="1" />
                                        <Setter Property="Height" Value="16" />
                                        <Setter Property="Margin" Value="4,0,6,0" />
                                        <Setter Property="Fill" Value="{StaticResource Border}" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button x:Name="BoldButton" Style="{StaticResource FormatButton}" Click="OnFormatBold" ToolTip="Bold (Ctrl+B)">
                                    <TextBlock Text="B" FontWeight="Bold" />
                                </Button>
                                <Button x:Name="ItalicButton" Style="{StaticResource FormatButton}" Click="OnFormatItalic" ToolTip="Italic (Ctrl+I)">
                                    <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia, serif" />
                                </Button>
                                <Button x:Name="UnderlineButton" Style="{StaticResource FormatButton}" Click="OnFormatUnderline" ToolTip="Underline (Ctrl+U)">
                                    <TextBlock Text="U" TextDecorations="Underline" />
                                </Button>
                                <Button x:Name="StrikeButton" Style="{StaticResource FormatButton}" Click="OnFormatStrike" ToolTip="Strikethrough (Ctrl+Shift+X)">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </Button>
                                <Rectangle />
                                <Button x:Name="BulletsButton" Style="{StaticResource FormatButton}" Click="OnFormatBullets" Content="•  List"
                                        ToolTip="Bullets (Ctrl+Shift+8) - or type * and a space at the start of a line" />
                                <Button x:Name="NumbersButton" Style="{StaticResource FormatButton}" Click="OnFormatNumbers" Content="1.  List"
                                        ToolTip="Numbering (Ctrl+Shift+7) - or type 1. and a space; Enter counts on" />
                                <Button x:Name="DashesButton" Style="{StaticResource FormatButton}" Click="OnFormatDashes" Content="–  List"
                                        ToolTip="Dashes (Ctrl+Shift+9) - or type - and a space; Enter continues the list" />
                                <Rectangle />
                                <Button Style="{StaticResource FormatButton}" Click="OnFormatIndent" Content="⇥" ToolTip="Indent (Ctrl+])" />
                                <Button Style="{StaticResource FormatButton}" Click="OnFormatOutdent" Content="⇤" ToolTip="Outdent (Ctrl+[)" />
                                <Rectangle />
                                <Button Style="{StaticResource FormatButton}" Click="OnFormatClear" Content="Clear" ToolTip="Clear formatting (Ctrl+Space)" />
                                <Button Style="{StaticResource FormatButton}" Click="OnInsertPicture" Content="Picture…"
                                        ToolTip="Put a picture in the message from a file - or just paste one (Ctrl+V). Right-click a picture for its size and its shadow: soft, drop, slate drop or centre, as Outlook's picture styles have them" />
                            </StackPanel>

                            <!-- follow-up (Ctrl+Shift+F): Tab runs by, who, what, then the two toggles -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding Triage.Composer.IsFollowingUp, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Follow up" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" x:Name="FollowUpBox" Style="{StaticResource FlatInput}" FontSize="13"
                                         Text="{Binding Triage.Composer.FollowUpWhen, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="{Binding Triage.Composer.FollowUpWhenPreview}" FontSize="12"
                                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />

                                <TextBlock Grid.Row="1" Text="Who" FontSize="12" Margin="0,6,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource FlatInput}" FontSize="13"
                                         Text="{Binding Triage.Composer.FollowUpWho, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Triage.Composer.FollowUpWhoPreview}" FontSize="12"
                                           Margin="10,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Muted}" />

                                <TextBlock Grid.Row="2" Text="What" FontSize="12" Margin="0,6,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                         Style="{StaticResource FlatInput}" FontSize="13"
                                         ToolTip="Optional - e.g. send the revised drawings"
                                         Text="{Binding Triage.Composer.FollowUpWhat, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox IsChecked="{Binding Triage.Composer.TrackAsTask}" VerticalAlignment="Center"
                                              Foreground="{StaticResource Text}" FontSize="12"
                                              ToolTip="On the day, it moves to the board's Follow up column for a chase">
                                        Track it on the board (Ctrl+Shift+T)
                                    </CheckBox>
                                    <CheckBox IsChecked="{Binding Triage.Composer.MentionInEmail}" VerticalAlignment="Center"
                                              Margin="18,0,0,0" Foreground="{StaticResource Text}" FontSize="12">
                                        Add a follow-up line to the email
                                    </CheckBox>
                                </StackPanel>
                            </Grid>

                            <!-- the way in for the mouse; Ctrl+Shift+F from the keyboard -->
                            <Button Content="+ Follow up" HorizontalAlignment="Left" Margin="0,0,0,8"
                                    Style="{StaticResource ReportButton}" Click="OnFollowUpButtonClick"
                                    ToolTip="Pick a day to follow up and who it's waiting on (Ctrl+Shift+F)"
                                    Visibility="{Binding Triage.Composer.IsFollowingUp, Converter={StaticResource BoolVisInv}}" />

                            <!-- link (Ctrl+K): Enter puts it in the message, Esc goes back -->
                            <DockPanel Margin="0,0,0,10"
                                       Visibility="{Binding Triage.Composer.IsLinking, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Link" FontSize="12" VerticalAlignment="Center" Width="52"
                                           Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                <TextBlock Text="Text" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{StaticResource Muted}" />
                                <TextBox x:Name="LinkLabelBox" Width="200" Style="{StaticResource FlatInput}" FontSize="13"
                                         Text="{Binding Triage.Composer.LinkLabel, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Address" FontSize="12" VerticalAlignment="Center" Margin="14,0,8,0"
                                           Foreground="{StaticResource Muted}" />
                                <TextBlock DockPanel.Dock="Right" Text="Enter to insert · Esc to cancel" FontSize="12"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource Muted}" />
                                <TextBox x:Name="LinkAddressBox" Style="{StaticResource FlatInput}" FontSize="13"
                                         Text="{Binding Triage.Composer.LinkAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>

                            <!-- send later (Ctrl+Shift+L) -->
                            <DockPanel Margin="0,0,0,10"
                                       Visibility="{Binding Triage.Composer.IsScheduling, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Send at" FontSize="12" VerticalAlignment="Center" Width="52"
                                           Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                <TextBox x:Name="ScheduleBox" Width="170" Style="{StaticResource FlatInput}" FontSize="13"
                                         Text="{Binding Triage.Composer.ScheduleText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Triage.Composer.SchedulePreview}" FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource Muted}" Width="200" />
                                <CheckBox IsChecked="{Binding Triage.Composer.HoldIfReplied}" VerticalAlignment="Center"
                                          Foreground="{StaticResource Text}" FontSize="12">
                                    If anyone replies first, don't send - hold it for my review
                                </CheckBox>
                            </DockPanel>
                        <Grid>
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}"
                                       Text="Ctrl+Enter send · Ctrl+Shift+Enter send &amp; done · Ctrl+G AI draft · Ctrl+Shift+L later · Ctrl+Shift+F follow-up · Ctrl+K link · Esc discard · @ mentions · paste pictures · drop files to attach"
                                       Visibility="{Binding Triage.Composer.IsNew, Converter={StaticResource BoolVisInv}}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}"
                                       Text="Ctrl+Enter send · Ctrl+G AI draft · Ctrl+Shift+L later · Ctrl+Shift+F follow-up · Ctrl+Shift+S subject · Ctrl+K link · Esc discard · @ mentions · paste pictures · drop files to attach"
                                       Visibility="{Binding Triage.Composer.IsNew, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="{Binding Triage.Composer.Status}" FontSize="11"
                                       HorizontalAlignment="Right" Foreground="{StaticResource Warn}"
                                       Background="{StaticResource Raised}" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- needs action (a): what, who, when and how to chase, asked once -->
        <Grid Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding Triage.Capture.IsOpen, Converter={StaticResource BoolVis}}">
            <Border x:Name="CaptureCard" Width="620" VerticalAlignment="Top" Margin="0,80,0,0"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <Border.Resources>
                    <Style x:Key="CaptureLabel" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10.5" />
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Setter Property="Margin" Value="0,10,0,4" />
                    </Style>
                    <Style x:Key="CapturePreview" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Setter Property="Margin" Value="0,3,0,0" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </Border.Resources>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="16,14,16,0">
                        <TextBlock Text="NEEDS ACTION" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Triage.Capture.ContextLine}" FontSize="12.5" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="16,2,16,12">
                        <!-- what -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="type to replace" Style="{StaticResource CaptureLabel}" />
                            <TextBlock Text="What needs to happen" Style="{StaticResource CaptureLabel}" />
                        </DockPanel>
                        <TextBox x:Name="CaptureTitle" Style="{StaticResource FlatInput}" FontSize="15"
                                 Text="{Binding Triage.Capture.Title, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- who -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Triage.Capture.WhoKindLabel}" Style="{StaticResource CaptureLabel}" />
                            <TextBlock Text="Who has the ball" Style="{StaticResource CaptureLabel}" />
                        </DockPanel>
                        <TextBox x:Name="CaptureWho" Style="{StaticResource FlatInput}"
                                 GotKeyboardFocus="OnCaptureWhoFocus" LostKeyboardFocus="OnCaptureWhoBlur"
                                 Text="{Binding Triage.Capture.Who, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding Triage.Capture.WhoPreview}" Style="{StaticResource CapturePreview}" />
                        <Border Background="{StaticResource Raised}" CornerRadius="5" Margin="0,4,0,0"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                Visibility="{Binding Triage.Capture.HasSuggestions, Converter={StaticResource BoolVis}}">
                            <ListBox ItemsSource="{Binding Triage.Capture.Suggestions}"
                                     SelectedIndex="{Binding Triage.Capture.SuggestionIndex, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource MailRowContainer}"
                                     Background="Transparent" BorderThickness="0" Focusable="False" MaxHeight="150"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="10,5">
                                            <TextBlock x:Name="NameText" Text="{Binding Display}" FontSize="12.5"
                                                       Foreground="{StaticResource Text}" />
                                            <TextBlock x:Name="AddressText" Text="{Binding Address}" FontSize="11" Margin="10,1,0,0"
                                                       Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource SelectedText}" />
                                                <Setter TargetName="AddressText" Property="Foreground" Value="{StaticResource SelectedMuted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- when: due, and the day to chase -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Due" Style="{StaticResource CaptureLabel}" />
                                <TextBox x:Name="CaptureDue" Style="{StaticResource FlatInput}"
                                         Text="{Binding Triage.Capture.DueText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Triage.Capture.DuePreview}" Style="{StaticResource CapturePreview}" />
                            </StackPanel>
                            <!-- always shown; only a named person can be chased, so it waits for Who -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Follow up" Style="{StaticResource CaptureLabel}" />
                                <TextBox x:Name="CaptureFollowUp" Style="{StaticResource FlatInput}"
                                         IsEnabled="{Binding Triage.Capture.HasWho}"
                                         Text="{Binding Triage.Capture.FollowUpText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding Triage.Capture.FollowUpPreview}" Style="{StaticResource CapturePreview}" />
                            </StackPanel>
                        </Grid>

                        <!-- notes -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Ctrl+N" Style="{StaticResource CaptureLabel}" />
                            <TextBlock Text="Notes" Style="{StaticResource CaptureLabel}" />
                        </DockPanel>
                        <TextBox x:Name="CaptureNotes" Style="{StaticResource FlatInput}"
                                 AcceptsReturn="False" TextWrapping="Wrap" MinHeight="56" VerticalContentAlignment="Top"
                                 Text="{Binding Triage.Capture.Notes, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- priority, tell them -->
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Triage.Capture.TellLabel}" FontSize="11"
                                       Foreground="{StaticResource Muted}"
                                       Visibility="{Binding Triage.Capture.CanTell, Converter={StaticResource BoolVis}}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource Muted}">
                                <Run Text="{Binding Triage.Capture.PriorityLabel, Mode=OneWay}" /><Run Text="   Ctrl+P" />
                            </TextBlock>
                        </DockPanel>

                        <!-- where it lands -->
                        <Border Background="#1A7AA2F7" CornerRadius="5" Padding="12,8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Triage.Capture.ResultLine}" FontSize="12"
                                       Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#22E0AF68" CornerRadius="5" Padding="12,8" Margin="0,6,0,0"
                                Visibility="{Binding Triage.Capture.Problem, Converter={StaticResource NullVis}}">
                            <TextBlock Text="{Binding Triage.Capture.Problem}" FontSize="12"
                                       Foreground="{StaticResource Warn}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" Background="{StaticResource Raised}" CornerRadius="0,0,9,9" Padding="16,9">
                        <TextBlock Text="{Binding Triage.Capture.Hint}" FontSize="11"
                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- stale review (Shift+R): one neglected card at a time, its email still showing beneath -->
        <Grid Grid.RowSpan="3" Background="#70000000"
              Visibility="{Binding Actions.IsReviewing, Converter={StaticResource BoolVis}}">
            <Border Width="620" VerticalAlignment="Top" Margin="0,80,0,0"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="18,14,18,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Actions.ReviewPosition}" FontSize="12"
                                       Foreground="{StaticResource Muted}" />
                            <TextBlock Text="STILL A THING?" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Actions.ReviewItem.DisplayTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                            <Run Text="{Binding Actions.ReviewItem.SenderName, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding Actions.ReviewItem.ReceivedUtc, Mode=OneWay, StringFormat='received {0:ddd d MMM}'}" />
                            <Run Text="·" />
                            <Run Text="{Binding Actions.ReviewItem.Stage, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding Actions.ReviewItem.StaleDays, Mode=OneWay, StringFormat='untouched for {0} days'}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding Actions.ReviewItem.WaitingLine}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                   Visibility="{Binding Actions.ReviewItem.IsWaiting, Converter={StaticResource BoolVis}}" />
                        <TextBlock Text="{Binding Actions.ReviewItem.Notes}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource Text}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Actions.ReviewItem.Notes, Converter={StaticResource NullVis}}" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource Raised}" CornerRadius="0,0,9,9" Padding="18,9">
                        <TextBlock Text="{Binding Actions.ReviewHint}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- inline editor for notes / blockers / assignments -->
        <Grid Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding Actions.Editor, Converter={StaticResource EditorVis}}">
            <Border Width="620" VerticalAlignment="Center"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Margin="18,16">
                    <TextBlock Text="{Binding Actions.EditorTitle}" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding Actions.Editor, Converter={StaticResource EditorPrimaryLabel}}"
                               FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox x:Name="EditorPrimary" Style="{StaticResource FlatInput}"
                             AcceptsReturn="{Binding Actions.Editor, Converter={StaticResource EditorMultiline}}"
                             TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                             Text="{Binding Actions.FieldPrimary, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Visibility="{Binding Actions.Editor, Converter={StaticResource EditorFields}}">
                        <TextBlock Text="{Binding Actions.Editor, Converter={StaticResource EditorSecondaryLabel}}"
                                   FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,10,0,4" />
                        <TextBox Style="{StaticResource FlatInput}"
                                 Text="{Binding Actions.FieldSecondary, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Due (optional) - e.g. friday, 3d, 12 oct"
                                   FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,10,0,4" />
                        <TextBox Style="{StaticResource FlatInput}"
                                 Text="{Binding Actions.FieldDue, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Actions.EditorHint}" FontSize="11" Margin="0,12,0,0"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- help -->
        <Grid Grid.RowSpan="3" Background="#D0000000"
              Visibility="{Binding IsHelpVisible, Converter={StaticResource BoolVis}}">
            <Border MaxWidth="760" MaxHeight="620" VerticalAlignment="Center"
                    Background="{StaticResource Panel}" CornerRadius="9"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid Margin="24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Keyboard" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HelpList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="74" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Group}" FontSize="10.5"
                                               Foreground="{StaticResource Muted}" />
                                    <Border Grid.Column="1" Style="{StaticResource KeyCap}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Keys}" Style="{StaticResource KeyCapText}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12.5" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>

                    <TextBlock Grid.Row="2" Text="Any key to close · bindings live in %APPDATA%\EmailTriage\keybindings.json"
                               FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Lavish =================
             The button is drawn here, over the top bar, rather than inside it:
             the pop-ups above (reply, palette, capture, help) each cover the
             whole window, and Lavish has to stay reachable over all of them. -->
        <Button x:Name="LavishButton" Style="{StaticResource LavishButton}" Grid.Row="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                Click="OnLavishButtonClick"
                ToolTip="Lavish - click any part of the app and say what should change. It is filed as a GitHub issue you can follow to a release. (Ctrl+Shift+L)">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lavish" Style="{StaticResource LavishMark}" FontSize="15"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Border Background="{StaticResource LavishBrass}" CornerRadius="8" MinWidth="16" Height="16"
                        Padding="4,0" Margin="7,1,0,0" VerticalAlignment="Center"
                        Visibility="{Binding Lavish.OpenCount, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding Lavish.OpenCount}" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource LavishBrassInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Button>

        <!-- comment mode itself, over everything, button included -->
        <views:LavishOverlay x:Name="LavishLayer" Grid.RowSpan="3" />
    </Grid>
</Window>
