<Window x:Class="EmailTriage.App.Views.PairPhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair an iPhone or iPad"
        SizeToContent="Height" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <StackPanel Margin="28,22,28,22">
        <TextBlock Text="Scan this with the Email Triage app" FontSize="15" FontWeight="SemiBold" />
        <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0">
            Open the app on your iPhone or iPad, tap Scan pairing code, and point the camera here. It connects over
            the same Wi-Fi as this PC, or from anywhere through the relay when one is set up in Settings.
        </TextBlock>

        <!-- QR codes need a light quiet zone around them to scan. -->
        <Border Background="White" CornerRadius="8" Padding="14" Margin="0,18,0,0" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="300" Height="300" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock Text="No camera? Copy this link to the device and paste it in the app:" FontSize="11.5"
                   Foreground="{StaticResource Muted}" Margin="0,18,0,5" TextWrapping="Wrap" />
        <TextBox x:Name="LinkBox" Style="{StaticResource FlatInput}" IsReadOnly="True" FontSize="11"
                 TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" />

        <TextBlock x:Name="Warning" FontSize="11.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                   Margin="0,12,0,0" Visibility="Collapsed" />

        <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0">
            Anyone holding this code can read your mail while on your network, so don't share it.
            If the device can't connect, Windows Firewall may be blocking it: allow Email Triage on private networks
            when Windows asks. That can need your IT department on a managed PC.
        </TextBlock>

        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Click="OnDoneClick" Tag="on" Style="{StaticResource ReportButton}" />
            <Button Content="Unpair all devices" Click="OnUnpairClick" HorizontalAlignment="Left"
                    Style="{StaticResource ReportButton}"
                    ToolTip="Makes a new code. Devices paired before stop working until you pair them again." />
        </DockPanel>
    </StackPanel>
</Window>
