<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:EmailTriage.App.Services">

    <!-- A dark, low-contrast shell: this is a tool to stare at for an hour at
         a time, so nothing competes with the message content. -->
    <Color x:Key="BgColor">#12141A</Color>
    <Color x:Key="PanelColor">#181B22</Color>
    <Color x:Key="RaisedColor">#1F2430</Color>
    <Color x:Key="BorderColor">#2A3040</Color>
    <Color x:Key="TextColor">#D6D9E0</Color>
    <Color x:Key="MutedColor">#858C9A</Color>
    <Color x:Key="AccentColor">#7AA2F7</Color>
    <Color x:Key="WarnColor">#E0AF68</Color>
    <Color x:Key="DangerColor">#E06C75</Color>
    <Color x:Key="OkColor">#98C379</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />

    <!-- The selected message in the triage list: light yellow, dark text. -->
    <SolidColorBrush x:Key="SelectedRow" Color="#FFF1A8" />
    <SolidColorBrush x:Key="SelectedText" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SelectedMuted" Color="#5C5540" />

    <svc:BoolToVisibilityConverter x:Key="BoolVis" />
    <svc:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
    <svc:NullToVisibilityConverter x:Key="NullVis" />
    <svc:NullToVisibilityConverter x:Key="NullVisInv" Invert="True" />
    <svc:SectionVisibilityConverter x:Key="SectionVis" />
    <svc:SectionActiveConverter x:Key="SectionActive" />
    <svc:PriorityBrushConverter x:Key="PriorityBrush" />
    <svc:CountToVisibilityConverter x:Key="CountVis" />
    <svc:CountToVisibilityConverter x:Key="CountVisInv" Invert="True" />
    <svc:EditorVisibilityConverter x:Key="EditorVis" />
    <svc:EditorMultilineConverter x:Key="EditorMultiline" />
    <svc:EditorExtraFieldsConverter x:Key="EditorFields" />
    <svc:EditorPrimaryLabelConverter x:Key="EditorPrimaryLabel" />
    <svc:EditorSecondaryLabelConverter x:Key="EditorSecondaryLabel" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- The chip used to show a key like `k` inline in hints and help. -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="22" />
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FlatInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>

    <Style x:Key="SectionTab" TargetType="TextBlock">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

</ResourceDictionary>
