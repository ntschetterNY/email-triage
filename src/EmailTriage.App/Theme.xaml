<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:EmailTriage.App.Services">

    <!-- A dark, low-contrast shell: this is a tool to stare at for an hour at
         a time, so nothing competes with the message content. -->
    <Color x:Key="BgColor">#12141A</Color>
    <Color x:Key="PanelColor">#181B22</Color>
    <Color x:Key="RaisedColor">#1F2430</Color>
    <Color x:Key="BorderColor">#2A3040</Color>
    <Color x:Key="TextColor">#D6D9E0</Color>
    <Color x:Key="MutedColor">#858C9A</Color>
    <Color x:Key="AccentColor">#7AA2F7</Color>
    <Color x:Key="WarnColor">#E0AF68</Color>
    <Color x:Key="DangerColor">#E06C75</Color>
    <Color x:Key="OkColor">#98C379</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}" />

    <!-- The selected message in the triage list: light yellow, dark text. -->
    <SolidColorBrush x:Key="SelectedRow" Color="#FFF1A8" />
    <SolidColorBrush x:Key="SelectedText" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SelectedMuted" Color="#5C5540" />

    <svc:BoolToVisibilityConverter x:Key="BoolVis" />
    <svc:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
    <svc:NullToVisibilityConverter x:Key="NullVis" />
    <svc:NullToVisibilityConverter x:Key="NullVisInv" Invert="True" />
    <svc:SectionVisibilityConverter x:Key="SectionVis" />
    <svc:SectionActiveConverter x:Key="SectionActive" />
    <svc:MatchTagConverter x:Key="MatchTag" />
    <svc:PriorityBrushConverter x:Key="PriorityBrush" />
    <svc:CountToVisibilityConverter x:Key="CountVis" />
    <svc:CountToVisibilityConverter x:Key="CountVisInv" Invert="True" />
    <svc:EditorVisibilityConverter x:Key="EditorVis" />
    <svc:EditorMultilineConverter x:Key="EditorMultiline" />
    <svc:EditorExtraFieldsConverter x:Key="EditorFields" />
    <svc:EditorPrimaryLabelConverter x:Key="EditorPrimaryLabel" />
    <svc:EditorSecondaryLabelConverter x:Key="EditorSecondaryLabel" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- The chip used to show a key like `k` inline in hints and help. -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="MinWidth" Value="22" />
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FlatInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- The message box of the composer: FlatInput's look on a RichTextBox. -->
    <Style x:Key="FlatRichInput" TargetType="RichTextBox">
        <Setter Property="Background" Value="{StaticResource Raised}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="AcceptsTab" Value="False" />
    </Style>

    <!-- Formatting buttons under the message: never take focus, so the
         selection they act on stays put. Tag="on" shows the state at the caret. -->
    <Style x:Key="FormatButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource Raised}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Border}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="B" Property="Background" Value="#337AA2F7" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text that reads like a TextBlock but can be selected and copied.
         Keys still reach the window first, so shortcuts keep working. -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="-2,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="SectionTab" TargetType="TextBlock">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <!-- Small flat buttons: the top bar, the action tab and Settings. Tag="on" marks the active toggle. -->
    <Style x:Key="ReportButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="4" Padding="10,3">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="11.5" Foreground="{StaticResource Text}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="B" Property="Background" Value="#337AA2F7" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Lavish =================
         The comment layer borrows lavish-axi's look (github.com/kunchenguid/lavish-axi):
         warm ink panels, a brass accent, cream text and an italic serif wordmark, so it
         reads as a tool laid over the app rather than part of it. -->
    <Color x:Key="LavishInkColor">#0F1115</Color>
    <Color x:Key="LavishBarColor">#171A21</Color>
    <Color x:Key="LavishElevatedColor">#1C212B</Color>
    <Color x:Key="LavishBorderColor">#303745</Color>
    <Color x:Key="LavishBrassColor">#F4C95D</Color>

    <SolidColorBrush x:Key="LavishInk" Color="{StaticResource LavishInkColor}" />
    <SolidColorBrush x:Key="LavishBar" Color="{StaticResource LavishBarColor}" />
    <SolidColorBrush x:Key="LavishElevated" Color="{StaticResource LavishElevatedColor}" />
    <SolidColorBrush x:Key="LavishBorder" Color="{StaticResource LavishBorderColor}" />
    <SolidColorBrush x:Key="LavishBorderSubtle" Color="#2A2F3A" />
    <SolidColorBrush x:Key="LavishCream" Color="#F7F3EA" />
    <SolidColorBrush x:Key="LavishMuted" Color="#D8DEEA" />
    <SolidColorBrush x:Key="LavishLabel" Color="#8C96AA" />
    <SolidColorBrush x:Key="LavishBrass" Color="{StaticResource LavishBrassColor}" />
    <SolidColorBrush x:Key="LavishBrassHover" Color="#FFD877" />
    <SolidColorBrush x:Key="LavishBrassInk" Color="#17130A" />
    <!-- The amber wash lavish-axi puts behind a note's anchor line. -->
    <SolidColorBrush x:Key="LavishAnchor" Color="#805D4D1B" />

    <FontFamily x:Key="LavishSerif">EB Garamond, Iowan Old Style, Georgia</FontFamily>

    <!-- The wordmark: italic serif, as on lavish-axi's bar. -->
    <Style x:Key="LavishMark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LavishSerif}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Foreground" Value="{StaticResource LavishCream}" />
    </Style>

    <!-- Small uppercase labels ("NOTE", "FEEDBACK"). -->
    <Style x:Key="LavishCaps" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LavishLabel}" />
    </Style>

    <!-- The top-bar button. Tag="on" while comment mode is on: brass, like lavish-axi's Annotate switch. -->
    <Style x:Key="LavishButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource LavishCream}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{StaticResource LavishBar}" BorderBrush="{StaticResource LavishBorder}"
                            BorderThickness="1" CornerRadius="9" Padding="10,1,8,2">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LavishBrass}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource LavishBrass}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LavishBrass}" />
                            <Setter Property="Foreground" Value="{StaticResource LavishBrassInk}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one filled button: brass with dark ink, radius 10. -->
    <Style x:Key="LavishPrimary" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="{StaticResource LavishBrass}" CornerRadius="10" Padding="14,7">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{StaticResource LavishBrassInk}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource LavishBrassHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="B" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet text buttons: close, open on GitHub. -->
    <Style x:Key="LavishGhost" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="8,4">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="12"
                                   Foreground="{StaticResource LavishLabel}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource LavishElevated}" />
                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource LavishCream}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The comment box: ink well, radius 12, brass when focused. -->
    <Style x:Key="LavishInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource LavishCream}" />
        <Setter Property="CaretBrush" Value="{StaticResource LavishBrass}" />
        <Setter Property="SelectionBrush" Value="{StaticResource LavishBrass}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="B" Background="{StaticResource LavishInk}" BorderBrush="{StaticResource LavishBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="8,7">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LavishBrass}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every checkbox: the stock one draws a white box, which glares on the dark shell. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                BorderBrush="{StaticResource Muted}" BorderThickness="1" Background="{StaticResource Raised}">
                            <TextBlock x:Name="Tick" Text="✓" FontSize="10" FontWeight="Bold" Visibility="Collapsed"
                                       Foreground="{StaticResource Bg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1" x:Name="Content" Margin="7,0,0,0" RecognizesAccessKey="True"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LavishCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="4" VerticalAlignment="Top" Margin="0,1,8,0"
                                BorderBrush="{StaticResource LavishBorder}" BorderThickness="1" Background="{StaticResource LavishInk}">
                            <TextBlock x:Name="Tick" Text="✓" FontSize="10" FontWeight="Bold" Visibility="Collapsed"
                                       Foreground="{StaticResource LavishBrassInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource LavishBrass}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource LavishBrass}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
